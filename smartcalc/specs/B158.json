{
  "description": "중간예납 세액을 넣으면 분납 가능액과 2026년 11월 30일까지 일시불로 낼 금액을 계산합니다. 세액 1,000만 원 초과 시 분납 가능, 2,000만 원 이하는 초과분만, 2,000만 원 초과는 세액의 50%까지 분납할 수 있습니다 (국세청 분납 사례표 기준).",
  "eligibility_gates": [
    {
      "id": "installment_eligible",
      "when": {
        "op": "le",
        "left": {
          "op": "var",
          "name": "tax"
        },
        "right": {
          "op": "const",
          "value": 10000000
        }
      },
      "reason": "분납이 불가능합니다. 중간예납 세액이 10,000,000원을 초과해야 분납을 신청할 수 있습니다.",
      "alternative": "세액이 10,000,000원 이하이면 분납 대상이 아니므로 2026년 11월 30일까지 전액을 일시불로 납부해야 합니다."
    }
  ],
  "id": "B158",
  "inputs": [
    {
      "default": 12500000,
      "key": "tax",
      "label": "중간예납 세액 (원)",
      "max": 1000000000,
      "min": 0,
      "step": 10000,
      "type": "number"
    }
  ],
  "outputs": {
    "applied": [
      {
        "text": "세액 {tax} — 분납 가능액 {installment}, 11월 30일까지 {due_now} 일시불 납부"
      },
      {
        "text": "분납 납부기한: 2027년 2월 1일"
      }
    ],
    "caution": {
      "text": "50% 구간의 분납액은 세액의 절반에서 10원 미만을 버린 금액입니다 (사례표 30,000,010원→15,000,000원, 99,999,990원→49,999,990원과 일치하는 추론 — 고지서 금액과 다르면 고지서가 정본입니다). 참고용 계산이며 세무·금융 자문이 아닙니다."
    },
    "headline": {
      "label": "분납 가능액",
      "value": {
        "op": "var",
        "name": "installment"
      },
      "format": "krw"
    },
    "rows": [
      {
        "label": "중간예납 세액",
        "value": {
          "op": "var",
          "name": "tax"
        },
        "format": "krw"
      },
      {
        "label": "분납 가능액",
        "value": {
          "op": "var",
          "name": "installment"
        },
        "format": "krw"
      },
      {
        "label": "2026년 11월 30일까지 일시불 납부액",
        "value": {
          "op": "var",
          "name": "due_now"
        },
        "format": "krw"
      }
    ]
  },
  "sources": [
    {
      "label": "국세청 종합소득세 중간예납 분납 안내 (분납 사례표)",
      "url": "https://www.nts.go.kr/nts/cm/cntnts/cntntsView.do?cntntsId=7674&mi=2237"
    }
  ],
  "steps": {
    "half_raw": {
      "op": "mul",
      "left": {
        "op": "var",
        "name": "tax"
      },
      "right": {
        "op": "const",
        "value": 0.5
      }
    },
    "half_div10": {
      "op": "div",
      "left": {
        "op": "var",
        "name": "half_raw"
      },
      "right": {
        "op": "const",
        "value": 10
      }
    },
    "half_floor": {
      "op": "floor",
      "value": {
        "op": "var",
        "name": "half_div10"
      }
    },
    "installment": {
      "op": "if",
      "cond": {
        "op": "gt",
        "left": {
          "op": "var",
          "name": "tax"
        },
        "right": {
          "op": "const",
          "value": 20000000
        }
      },
      "then": {
        "op": "mul",
        "left": {
          "op": "var",
          "name": "half_floor"
        },
        "right": {
          "op": "const",
          "value": 10
        }
      },
      "else": {
        "op": "sub",
        "left": {
          "op": "var",
          "name": "tax"
        },
        "right": {
          "op": "const",
          "value": 10000000
        }
      }
    },
    "due_now": {
      "op": "sub",
      "left": {
        "op": "var",
        "name": "tax"
      },
      "right": {
        "op": "var",
        "name": "installment"
      }
    }
  },
  "test_vectors": [
    {
      "name": "V1 세액 12,500,000원 (본문 예시)",
      "inputs": {
        "tax": 12500000
      },
      "expect": {
        "values": {
          "due_now": 10000000,
          "installment": 2500000
        }
      },
      "applied_contains": [
        "분납 가능액 2,500,000"
      ],
      "note": "본문 예시: 세액 12,500,000원 → 최대 분납 2,500,000원"
    },
    {
      "name": "V2 세액 18,000,000원 (본문 예시)",
      "inputs": {
        "tax": 18000000
      },
      "expect": {
        "values": {
          "due_now": 10000000,
          "installment": 8000000
        }
      },
      "applied_contains": [
        "분납 가능액 8,000,000"
      ],
      "note": "본문 예시: 세액 18,000,000원 → 최대 분납 8,000,000원"
    },
    {
      "name": "V3 세액 30,000,010원 (본문 예시, 10원 절사)",
      "inputs": {
        "tax": 30000010
      },
      "expect": {
        "values": {
          "due_now": 15000010,
          "installment": 15000000
        }
      },
      "applied_contains": [
        "분납 가능액 15,000,000"
      ],
      "note": "본문 예시: 세액 30,000,010원 → 최대 분납 15,000,000원 (절반 15,000,005원에서 10원 미만 절사)"
    },
    {
      "name": "V4 세액 99,999,990원 (본문 예시, 10원 절사)",
      "inputs": {
        "tax": 99999990
      },
      "expect": {
        "values": {
          "due_now": 50000000,
          "installment": 49999990
        }
      },
      "applied_contains": [
        "분납 가능액 49,999,990"
      ],
      "note": "본문 예시: 세액 99,999,990원 → 최대 분납 49,999,990원 (절반 49,999,995원에서 10원 미만 절사)"
    },
    {
      "name": "V5 경계 세액 10,000,000원 (분납 불가)",
      "inputs": {
        "tax": 10000000
      },
      "expect": {
        "eligible": false,
        "gate": "installment_eligible"
      },
      "note": "경계: 세액이 정확히 1,000만 원이면 '초과' 요건 미충족으로 분납 불가 (본문: 10,000,000원 초과해야 분납 가능)"
    },
    {
      "name": "V6 경계 세액 20,000,000원 (초과분 방식)",
      "inputs": {
        "tax": 20000000
      },
      "expect": {
        "values": {
          "due_now": 10000000,
          "installment": 10000000
        }
      },
      "applied_contains": [
        "분납 가능액 10,000,000"
      ],
      "note": "경계: 세액 2,000만 원은 이하 구간 — 초과분 10,000,000원이 분납액"
    },
    {
      "name": "V7 경계 직상 세액 10,000,001원 (초과분 1원)",
      "inputs": {
        "tax": 10000001
      },
      "expect": {
        "values": {
          "due_now": 10000000,
          "installment": 1
        }
      },
      "applied_contains": [
        "분납 가능액 1"
      ],
      "note": "경계 직상: 1,000만 원을 1원 초과하면 초과분 1원만 분납 가능"
    },
    {
      "name": "V8 세액 25,000,000원 (50% 구간, 절사 없음)",
      "inputs": {
        "tax": 25000000
      },
      "expect": {
        "values": {
          "due_now": 12500000,
          "installment": 12500000
        }
      },
      "applied_contains": [
        "분납 가능액 12,500,000"
      ],
      "note": "50% 구간: 절반이 정확히 떨어져 절사 없음"
    }
  ],
  "title": "종합소득세 중간예납 분납 계산기",
  "version": 1,
  "schema": "calc_spec/v1"
}
